# Set these in Vercel -> Project Settings -> Environment Variables.
# Never commit a real .env file.

SESSION_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Twilio Verify (console.twilio.com -> Verify -> Services -> create a service, copy its SID)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Added automatically when you connect Upstash Redis from the Vercel Marketplace
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Added automatically when you create a Vercel Blob store and link it to this project
BLOB_READ_WRITE_TOKEN=
